<?xml version="1.0" encoding="utf-8"?>
<!-- Round launcher icon variant -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <solid android:color="#5C4033"/>
        </shape>
    </item>
    <item android:left="20dp" android:right="20dp"
          android:top="18dp" android:bottom="22dp">
        <shape android:shape="rectangle">
            <solid android:color="#FFFFFF"/>
            <corners android:radius="5dp"/>
        </shape>
    </item>
    <item android:left="24dp" android:right="24dp"
          android:top="30dp" android:bottom="38dp">
        <shape android:shape="rectangle">
            <solid android:color="#5C4033"/>
            <corners android:radius="2dp"/>
        </shape>
    </item>
</layer-list>
